<Page x:Class="SherioAPP.pages.OwnerPages.RoomsManagementPage"      FontFamily="Segoe UI"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="RoomsManagementPage"
      FlowDirection="RightToLeft"
      Background="#F8FAFC"
      Height="500"
      Width="800">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="ניהול החדרים שלי"
                       FontSize="22"
                       FontWeight="ExtraBold"
                       Foreground="#1E293B"/>

            <TextBlock x:Name="HotelNameTextBlock"
                       Text="מלון נוכחי"
                       FontSize="14"
                       Foreground="#64748B"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="8"
                    Margin="0,0,10,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">
                <DockPanel>
                    <materialDesign:PackIcon Kind="Bed"
                                             Foreground="#2563EB"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="כאן אפשר לערוך את פרטי החדרים של המלון שבחרת"
                               VerticalAlignment="Center"
                               Foreground="#475569"
                               FontSize="13"/>
                </DockPanel>
            </Border>

            <Button Grid.Column="1"
                    Content="רענן"
                    Background="#E2E8F0"
                    BorderBrush="#E2E8F0"
                    Foreground="#0F172A"
                    Height="35"
                    Margin="0,0,5,0"
                    Padding="14,0"
                    Click="Refresh_Click"/>

            <Button Grid.Column="2"
                    Content="💾 שמור"
                    Background="#10B981"
                    BorderBrush="#10B981"
                    Foreground="White"
                    Height="35"
                    Padding="14,0"
                    Click="Save_Click"/>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <DataGrid x:Name="RoomsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      RowHeight="40"
                      Background="White"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Margin="0">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="שם חדר"
                                        Binding="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}"
                                        Width="140"/>

                    <DataGridTextColumn Header="מחיר מבוגר"
                                        Binding="{Binding AdultRate, UpdateSourceTrigger=PropertyChanged}"
                                        Width="90"/>

                    <DataGridTextColumn Header="מחיר ילד"
                                        Binding="{Binding ChildRate, UpdateSourceTrigger=PropertyChanged}"
                                        Width="90"/>

                    <DataGridTextColumn Header="שינה"
                                        Binding="{Binding Bedrooms, UpdateSourceTrigger=PropertyChanged}"
                                        Width="60"/>

                    <DataGridTextColumn Header="מקלחות"
                                        Binding="{Binding Bathrooms, UpdateSourceTrigger=PropertyChanged}"
                                        Width="70"/>

                    <DataGridTextColumn Header="יחידות"
                                        Binding="{Binding TotalUnits, UpdateSourceTrigger=PropertyChanged}"
                                        Width="65"/>

                    <DataGridCheckBoxColumn Header="מטבח"
                                            Binding="{Binding HasKitchen, UpdateSourceTrigger=PropertyChanged}"
                                            Width="60"/>

                    <DataGridCheckBoxColumn Header="חניה"
                                            Binding="{Binding HasParking, UpdateSourceTrigger=PropertyChanged}"
                                            Width="60"/>

                    <DataGridCheckBoxColumn Header="מרפסת"
                                            Binding="{Binding HasBalcony, UpdateSourceTrigger=PropertyChanged}"
                                            Width="65"/>

                    <DataGridCheckBoxColumn Header="סלון"
                                            Binding="{Binding HasLivingRoom, UpdateSourceTrigger=PropertyChanged}"
                                            Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>