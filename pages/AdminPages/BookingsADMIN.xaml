<Page x:Class="SherioAPP.pages.AdminPages.BookingsADMIN"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:model="clr-namespace:Model;assembly=Model"
      FlowDirection="RightToLeft"
      FontFamily="Segoe UI"
      Background="#F8FAFC"
      Height="500"
      Width="800"
      Title="BookingsADMIN">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="ניהול הזמנות"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>

            <TextBlock Text="עריכה, שמירה וביטול הזמנות"
                       FontSize="14"
                       Foreground="#64748B"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,10,0"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <DockPanel>
                    <materialDesign:PackIcon Kind="Magnify"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,10,0"
                                             Foreground="#94A3B8"
                                             VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox"
                             TextChanged="SearchBox_TextChanged"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             materialDesign:HintAssist.Hint="חפש לפי הזמנה, משתמש, חדר או סטטוס..."
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                </DockPanel>
            </Border>

            <Button Grid.Column="1"
                    Content="💾 שמור הכל"
                    Width="120"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="#10B981"
                    BorderBrush="#10B981"
                    Foreground="White"
                    Click="SaveAllBookings_Click"/>

            <Button Grid.Column="2"
                    Content="⬅ חזרה לפאנל"
                    Width="140"
                    Height="38"
                    Background="#E2E8F0"
                    BorderBrush="#E2E8F0"
                    Foreground="#0F172A"
                    Click="BackToAdmin_Click"/>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <DataGrid x:Name="BookingsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      Background="White"
                      RowHeight="45"
                      BorderThickness="0"
                      FontSize="14"
                      SelectionUnit="FullRow"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      materialDesign:DataGridAssist.CellPadding="10">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Padding" Value="12,14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#475569"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="הזמנה ID"
                                        Binding="{Binding Id}"
                                        IsReadOnly="True"
                                        Width="70"/>

                    <DataGridTextColumn Header="משתמש ID"
                                        Binding="{Binding UserID}"
                                        IsReadOnly="True"
                                        Width="85"/>

                    <DataGridTextColumn Header="חדר ID"
                                        Binding="{Binding RoomID}"
                                        IsReadOnly="True"
                                        Width="75"/>

                    <DataGridTextColumn Header="צ'ק אין"
                                        Binding="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}"
                                        IsReadOnly="True"
                                        Width="95"/>

                    <DataGridTextColumn Header="צ'ק אאוט"
                                        Binding="{Binding EndDate, StringFormat={}{0:dd/MM/yyyy}}"
                                        IsReadOnly="True"
                                        Width="95"/>

                    <DataGridTextColumn Header="נוצר בתאריך"
                                        Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy}}"
                                        IsReadOnly="True"
                                        Width="100"/>

                    <DataGridTextColumn Header="מבוגרים"
                                        Binding="{Binding AdultCount, UpdateSourceTrigger=PropertyChanged}"
                                        Width="70"/>

                    <DataGridTextColumn Header="ילדים"
                                        Binding="{Binding ChildCount, UpdateSourceTrigger=PropertyChanged}"
                                        Width="65"/>

                    <DataGridTemplateColumn Header="סטטוס" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="{x:Static model:BookingStatus.Pending}"/>
                                    <ComboBoxItem Content="{x:Static model:BookingStatus.Confirmed}"/>
                                    <ComboBoxItem Content="{x:Static model:BookingStatus.CheckedOut}"/>
                                    <ComboBoxItem Content="{x:Static model:BookingStatus.Cancelled}"/>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="פעולות" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Click="SaveSingleBooking_Click"
                                            Width="34"
                                            Height="34"
                                            Foreground="#10B981"
                                            ToolTip="שמור">
                                        <materialDesign:PackIcon Kind="ContentSaveOutline"
                                                                 Width="20"
                                                                 Height="20"/>
                                    </Button>

                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Click="CancelBooking_Click"
                                            Width="34"
                                            Height="34"
                                            Margin="6,0,0,0"
                                            Foreground="#E11D48"
                                            ToolTip="בטל הזמנה">
                                        <materialDesign:PackIcon Kind="CloseCircleOutline"
                                                                 Width="20"
                                                                 Height="20"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>