<Page x:Class="SherioAPP.pages.AdminPages.PaymentsADMIN"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      FlowDirection="RightToLeft"
      FontFamily="Segoe UI"
      Background="#F8FAFC"
      Height="500"
      Width="800"
      Title="PaymentsADMIN">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="ניהול תשלומים"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>

            <TextBlock Text="עריכה, שמירה וחיפוש תשלומים"
                       FontSize="14"
                       Foreground="#64748B"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,10,0"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <DockPanel>
                    <materialDesign:PackIcon Kind="CashRegister"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,10,0"
                                             Foreground="#94A3B8"
                                             VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox"
                             TextChanged="SearchBox_TextChanged"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             materialDesign:HintAssist.Hint="חפש לפי מזהה תשלום, הזמנה, משתמש או שיטת תשלום..."
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                </DockPanel>
            </Border>

            <Button Grid.Column="1"
                    Content="💾 שמור הכל"
                    Width="120"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="#10B981"
                    BorderBrush="#10B981"
                    Foreground="White"
                    Click="SaveAllPayments_Click"/>

            <Button Grid.Column="2"
                    Content="⬅ חזרה לפאנל"
                    Width="140"
                    Height="38"
                    Background="#E2E8F0"
                    BorderBrush="#E2E8F0"
                    Foreground="#0F172A"
                    Click="BackToAdmin_Click"/>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <DataGrid x:Name="PaymentsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      Background="White"
                      RowHeight="45"
                      BorderThickness="0"
                      FontSize="14"
                      SelectionUnit="FullRow"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      materialDesign:DataGridAssist.CellPadding="10">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Padding" Value="12,14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#475569"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="תשלום ID"
                                        Binding="{Binding Id}"
                                        IsReadOnly="True"
                                        Width="80"/>

                    <DataGridTextColumn Header="הזמנה ID"
                                        Binding="{Binding BookingID}"
                                        IsReadOnly="True"
                                        Width="85"/>

                    <DataGridTextColumn Header="משתמש ID"
                                        Binding="{Binding UserID}"
                                        IsReadOnly="True"
                                        Width="85"/>

                    <DataGridTextColumn Header="סכום"
                                        Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                        Width="90"/>

                    <DataGridTextColumn Header="שיטת תשלום"
                                        Binding="{Binding PayMethod, UpdateSourceTrigger=PropertyChanged}"
                                        Width="120"/>

                    <DataGridTextColumn Header="תאריך יצירה"
                                        Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                        IsReadOnly="True"
                                        Width="140"/>

                    <DataGridTemplateColumn Header="פעולות" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Click="SaveSinglePayment_Click"
                                        Width="34"
                                        Height="34"
                                        Foreground="#10B981"
                                        ToolTip="שמור">
                                    <materialDesign:PackIcon Kind="ContentSaveOutline"
                                                             Width="20"
                                                             Height="20"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>